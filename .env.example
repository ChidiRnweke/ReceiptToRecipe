# Database
DATABASE_URL=postgresql://r2r:r2r@localhost:5432/r2r

# MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=r2r-images
MINIO_USE_SSL=false

# Mistral AI (OCR - Native)
MISTRAL_API_KEY=your_mistral_api_key

# OpenRouter (Culinary Intelligence & Product Normalization)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Image model for recipe pictures (any OpenRouter model with image output), e.g.
# google/gemini-2.5-flash-image, google/gemini-3.1-flash-lite-image or openai/gpt-5-image-mini.
# `npm run pictures:bakeoff` compares them on the same dishes.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Vision model that judges a member's snapped dish photo (defaults to OPENROUTER_MODEL)
OPENROUTER_VISION_MODEL=
# `seed` makes recipe pictures from the committed seed photos instead of an image model, for
# local runs without a working key. Also used when OPENROUTER_API_KEY is empty.
IMAGE_GENERATOR=
# Basil's model; defaults to OPENROUTER_MODEL. In `npm run dev` only, `scripted` uses a
# scripted stand-in that streams canned answers over the real tools and needs no key.
# BASIL_MODEL=scripted
# `rules` makes `npm run cookbook:import` structure Wikibooks pages with deterministic rules
# instead of the model. Also used when OPENROUTER_API_KEY is empty.
IMPORTER_STRUCTURER=

# OAuth2 / Auth0 Configuration
OAUTH_CLIENT_ID=your_auth0_client_id
OAUTH_CLIENT_SECRET=your_auth0_client_secret
OAUTH_DOMAIN=your-domain.us.auth0.com
OAUTH_CALLBACK_URL=http://localhost:5173/callback
